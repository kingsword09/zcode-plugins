{
  "name": "zcode-plugins",
  "private": true,
  "description": "Community plugins for the ZCode CLI runtime.",
  "license": "MIT",
  "type": "module",
  "workspaces": ["plugins/*"],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.4.1",
  "devDependencies": {
    "@types/bun": "^1.3.14"
  },
  "overrides": {
    "zod": "4.5.4"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "package:terminal-browser": "bun run --filter '@zcode-plugins/terminal-browser-plugin' package",
    "marketplace:dev": "bun run --filter '@zcode-plugins/terminal-browser-plugin' marketplace:dev",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test"
  }
}
